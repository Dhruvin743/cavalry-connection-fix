+/* Per-hwnd flags only — the visible stroke is the global overlay below. */
+void destroy_cavalry_noodle_overlay( struct x11drv_win_data *data )
+{
+    if (!data) return;
+    if (data->noodle_overlay_gc)
+    {
+        XFreeGC( gdi_display, data->noodle_overlay_gc );
+        data->noodle_overlay_gc = 0;
+    }
+    if (data->noodle_overlay)
+    {
+        XDestroyWindow( gdi_display, data->noodle_overlay );
+        data->noodle_overlay = 0;
+    }
+    if (data->noodle_overlay_colormap)
+    {
+        XFreeColormap( gdi_display, data->noodle_overlay_colormap );
+        data->noodle_overlay_colormap = 0;
+    }
+    data->noodle_overlay_w = data->noodle_overlay_h = 0;
+    data->noodle_display_valid = 0;
+}
+
+/* Global overlay: never touches win_data / win_data_mutex (that pairing aborted). */
+static struct
+{
+    Window   win;
+    GC       gc;
+    Colormap cmap;
+    INT      w, h;
+    BOOL     mapped;
+    BOOL     use_argb;
+} g_cavalry_noodle;
+
+void cavalry_global_noodle_hide(void)
+{
+    if (!g_cavalry_noodle.win || !g_cavalry_noodle.mapped) return;
+    XUnmapWindow( gdi_display, g_cavalry_noodle.win );
+    g_cavalry_noodle.mapped = FALSE;
+    XFlush( gdi_display );
+}
+
+static void cavalry_noodle_plot32( UINT32 *bits, INT stride, INT w, INT h,
+                                   INT x, INT y, UINT32 color, INT radius )
+{
+    INT dy, dx, r2 = radius * radius;
+    for (dy = -radius; dy <= radius; dy++)
+    {
+        INT py = y + dy;
+        if (py < 0 || py >= h) continue;
+        for (dx = -radius; dx <= radius; dx++)
+        {
+            INT px = x + dx;
+            if (px < 0 || px >= w) continue;
+            if (dx * dx + dy * dy <= r2)
+                bits[py * stride + px] = color;
+        }
+    }
+}
+
+void cavalry_global_noodle_show( const struct cavalry_noodle_paint *paint )
+{
+    INT width, height, i, max_points;
+    POINT pt;
+    XSetWindowAttributes attr;
+    XVisualInfo *vis;
+    float ax, ay, bx, by, mx, my, dx, dy, len, nx, ny, cx, cy, bulge;
+#ifdef HAVE_LIBXSHAPE
+    static XRectangle empty_rect;
+#endif
+
+    if (!paint) return;
+    width = paint->display.right - paint->display.left;
+    height = paint->display.bottom - paint->display.top;
+    if (width < 1) width = 1;
+    if (height < 1) height = 1;
+    /* Keep full drag span — clamping made the tip look stuck while Qt's noodle continued. */
+    if (width > 8192) width = 8192;
+    if (height > 8192) height = 8192;
+    pt = virtual_screen_to_root( paint->display.left, paint->display.top );
+
+    vis = (argb_visual.visual && argb_visual.depth == 32) ? &argb_visual : &default_visual;
+
+    if (!g_cavalry_noodle.win)
+    {
+        memset( &attr, 0, sizeof(attr) );
+        attr.override_redirect = True;
+        attr.bit_gravity = NorthWestGravity;
+        attr.border_pixel = 0;
+        attr.background_pixel = 0;
+        attr.event_mask = 0;
+        g_cavalry_noodle.use_argb = (vis == &argb_visual);
+        g_cavalry_noodle.cmap = g_cavalry_noodle.use_argb
+            ? XCreateColormap( gdi_display, root_window, vis->visual, AllocNone )
+            : default_colormap;
+        attr.colormap = g_cavalry_noodle.cmap;
+        g_cavalry_noodle.win = XCreateWindow( gdi_display, root_window, pt.x, pt.y, width, height, 0,
+                                              vis->depth, InputOutput, vis->visual,
+                                              CWOverrideRedirect | CWColormap | CWBorderPixel |
+                                              CWBackPixel | CWBitGravity | CWEventMask, &attr );
+        g_cavalry_noodle.gc = XCreateGC( gdi_display, g_cavalry_noodle.win, 0, NULL );
+#ifdef HAVE_LIBXSHAPE
+        /* Click-through only. Bounding stays full; ARGB alpha hides the rest. */
+        XShapeCombineRectangles( gdi_display, g_cavalry_noodle.win, ShapeInput, 0, 0,
+                                 &empty_rect, 1, ShapeSet, Unsorted );
+#endif
+        TRACE( "cavalry global noodle %lx argb=%d\n",
+               g_cavalry_noodle.win, g_cavalry_noodle.use_argb );
+    }
+    else if (g_cavalry_noodle.w != width || g_cavalry_noodle.h != height)
+        XMoveResizeWindow( gdi_display, g_cavalry_noodle.win, pt.x, pt.y, width, height );
+    else
+        XMoveWindow( gdi_display, g_cavalry_noodle.win, pt.x, pt.y );
+
+    g_cavalry_noodle.w = width;
+    g_cavalry_noodle.h = height;
+
+    ax = (float)paint->local_a.x; ay = (float)paint->local_a.y;
+    bx = (float)paint->local_b.x; by = (float)paint->local_b.y;
+    dx = bx - ax; dy = by - ay;
+    len = sqrtf( dx * dx + dy * dy );
+    if (len < 1.0f) len = 1.0f;
+    mx = (ax + bx) * 0.5f; my = (ay + by) * 0.5f;
+    nx = -dy / len; ny = dx / len;
+    /* Cavalry-like soft curve (was capped too low → looked like a straight bar). */
+    bulge = len * 0.28f;
+    if (bulge > 140.0f) bulge = 140.0f;
+    if (bulge < 12.0f && len > 40.0f) bulge = 12.0f;
+    cx = mx + nx * bulge; cy = my + ny * bulge;
+    max_points = (INT)len + 24;
+    if (max_points < 2) max_points = 2;
+    if (max_points > 8192) max_points = 8192;
+
+    if (g_cavalry_noodle.use_argb)
+    {
+        XImage *img;
+        UINT32 *bits;
+        INT stride;
+        /* Thin light stroke + small tips — closer to Cavalry's pale noodle. */
+        const UINT32 stroke = 0xD8D8DCE0;
+        const UINT32 tip = 0xFFE8ECF0;
+
+        img = XCreateImage( gdi_display, vis->visual, 32, ZPixmap, 0, NULL, width, height, 32, 0 );
+        if (!img) return;
+        bits = calloc( 1, (size_t)img->bytes_per_line * height );
+        if (!bits)
+        {
+            img->data = NULL;
+            XDestroyImage( img );
+            return;
+        }
+        img->data = (char *)bits;
+        stride = img->bytes_per_line / 4;
+
+        for (i = 0; i < max_points; i++)
+        {
+            float t = (float)i / (float)(max_points - 1);
+            float u = 1.0f - t;
+            float sx = u * u * ax + 2.0f * u * t * cx + t * t * bx;
+            float sy = u * u * ay + 2.0f * u * t * cy + t * t * by;
+            cavalry_noodle_plot32( bits, stride, width, height,
+                                   (INT)(sx + 0.5f), (INT)(sy + 0.5f), stroke, 1 );
+        }
+        cavalry_noodle_plot32( bits, stride, width, height,
+                               paint->local_a.x, paint->local_a.y, tip, 3 );
+        cavalry_noodle_plot32( bits, stride, width, height,
+                               paint->local_b.x, paint->local_b.y, tip, 3 );
+
+        XPutImage( gdi_display, g_cavalry_noodle.win, g_cavalry_noodle.gc, img,
+                   0, 0, 0, 0, width, height );
+        img->data = NULL;
+        free( bits );
+        XDestroyImage( img );
+    }
+    else
+    {
+        static unsigned long stroke_pixel, tip_pixel;
+        static BOOL have_pixels;
+        XPoint *pts;
+
+        if (!have_pixels)
+        {
+            XColor color;
+            color.red = 0xd800; color.green = 0xdc00; color.blue = 0xe000;
+            color.flags = DoRed | DoGreen | DoBlue;
+            if (!XAllocColor( gdi_display, default_colormap, &color ))
+                stroke_pixel = WhitePixel( gdi_display, DefaultScreen( gdi_display ) );
+            else
+                stroke_pixel = color.pixel;
+            color.red = 0xe800; color.green = 0xec00; color.blue = 0xf000;
+            if (!XAllocColor( gdi_display, default_colormap, &color ))
+                tip_pixel = stroke_pixel;
+            else
+                tip_pixel = color.pixel;
+            have_pixels = TRUE;
+        }
+        if (!(pts = malloc( max_points * sizeof(*pts) ))) return;
+        for (i = 0; i < max_points; i++)
+        {
+            float t = (float)i / (float)(max_points - 1);
+            float u = 1.0f - t;
+            pts[i].x = (short)(u * u * ax + 2.0f * u * t * cx + t * t * bx + 0.5f);
+            pts[i].y = (short)(u * u * ay + 2.0f * u * t * cy + t * t * by + 0.5f);
+        }
+        XClearWindow( gdi_display, g_cavalry_noodle.win );
+        XSetForeground( gdi_display, g_cavalry_noodle.gc, stroke_pixel );
+        XSetLineAttributes( gdi_display, g_cavalry_noodle.gc, 1, LineSolid, CapRound, JoinRound );
+        XDrawLines( gdi_display, g_cavalry_noodle.win, g_cavalry_noodle.gc, pts, max_points, CoordModeOrigin );
+        XSetForeground( gdi_display, g_cavalry_noodle.gc, tip_pixel );
+        XFillArc( gdi_display, g_cavalry_noodle.win, g_cavalry_noodle.gc,
+                  paint->local_a.x - 3, paint->local_a.y - 3, 6, 6, 0, 360 * 64 );
+        XFillArc( gdi_display, g_cavalry_noodle.win, g_cavalry_noodle.gc,
+                  paint->local_b.x - 3, paint->local_b.y - 3, 6, 6, 0, 360 * 64 );
+        free( pts );
+    }
+
+    XMapRaised( gdi_display, g_cavalry_noodle.win );
+    g_cavalry_noodle.mapped = TRUE;
+    XFlush( gdi_display );
+}
