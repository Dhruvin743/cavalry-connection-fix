+void cavalry_clear_drag_anchor(void)
+{
+    if (user_driver && user_driver->pWindowMessage)
+        user_driver->pWindowMessage( cavalry_noodle.hwnd ? cavalry_noodle.hwnd : NtUserGetDesktopWindow(),
+                                     WM_WINE_FIRST_DRIVER_MSG + 4, 1, 0 );
+    cavalry_noodle.have_anchor = FALSE;
+    cavalry_noodle.have_pending = FALSE;
+    cavalry_noodle.hwnd = 0;
