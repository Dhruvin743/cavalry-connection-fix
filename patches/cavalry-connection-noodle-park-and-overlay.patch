+/* Empty hit-test region for Cavalry noodles (Win32 geometry is also parked). */
+static void sync_layered_window_region( HWND hwnd, struct window_surface *surface )
+{
+    static const RECT empty;
+    NTSTATUS status;
+
+    (void)surface;
+    if (!hwnd) return;
+    SERVER_START_REQ( set_window_region )
+    {
+        req->window = wine_server_user_handle( hwnd );
+        req->redraw = 0;
+        wine_server_add_data( req, &empty, sizeof(empty) );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status) WARN( "empty_region hwnd=%p failed %x\n", hwnd, (int)status );
+    else TRACE( "empty_region hwnd=%p (cavalry noodle)\n", hwnd );
+}
