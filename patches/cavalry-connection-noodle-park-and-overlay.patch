+BOOL is_cavalry_connection_picker( HWND hwnd )
+{
+    static const WCHAR qt_iconW[] = {'Q','t','6','6','3','Q','W','i','n','d','o','w','I','c','o','n',0};
+    DWORD style, ex;
+    UNICODE_STRING name;
+    WCHAR buf[32];
+    INT len, width, height;
+    RECT rect;
+    HWND capture;
+
+    if (!hwnd) return FALSE;
+    capture = get_capture();
+    if (!capture || capture == hwnd) return FALSE;
+
+    style = get_window_long( hwnd, GWL_STYLE );
+    ex = get_window_long( hwnd, GWL_EXSTYLE );
+    if (!(style & WS_POPUP)) return FALSE;
+    if (style & (WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) return FALSE;
+    if (ex & WS_EX_LAYERED) return FALSE;
+
+    if (!get_window_rect( hwnd, &rect, get_thread_dpi() )) return FALSE;
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+    if (width < 300 || width > 420 || height < 90 || height > 160) return FALSE;
+
+    name.Buffer = buf;
+    name.MaximumLength = sizeof(buf);
+    name.Length = 0;
+    len = NtUserGetClassName( hwnd, FALSE, &name );
+    if (len < 16) return FALSE;
+    if (memcmp( buf, qt_iconW, 16 * sizeof(WCHAR) )) return FALSE;
+    return TRUE;
+}
+
+void make_cavalry_connection_picker_clickthrough( HWND hwnd )
+{
+    /* Disabled: size-gated click-through also matched the Ctrl+Q save dialog and
