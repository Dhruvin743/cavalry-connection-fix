+/* Optional diagnostic: also zero ULW pixels (invisible noodle). */
+static BOOL cavalry_invisible_noodle(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "CAVALRY_INVISIBLE_NOODLE" );
+        cached = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    return cached;
+}
+
+/* Parked Win32 geometry breaks Qt's ULW rubber-band paint. Track the drag
+ * start at SetCapture; stroke is drawn on a global X11 overlay. */
+struct cavalry_noodle_drag
+{
+    HWND hwnd;
+    POINT anchor;
+    BOOL have_anchor;
+    POINT pending;
+    BOOL have_pending;
+};
+
+static struct cavalry_noodle_drag cavalry_noodle;
+
+/* Cavalry attribute-connection rubber-band: Qt663QWindowIcon popup, no caption,
+ * UpdateLayeredWindow. Must not win Qt topLevelWindows() geometry hits under
+ * the cursor — park Win32 rect off-screen; stroke is drawn on a global overlay. */
+static BOOL is_cavalry_connection_noodle( HWND hwnd, const struct window_rects *rects )
+{
+    static const WCHAR qt_iconW[] = {'Q','t','6','6','3','Q','W','i','n','d','o','w','I','c','o','n',0};
+    DWORD style;
+    UNICODE_STRING name;
+    WCHAR buf[32];
+    INT len, width, height;
+    BOOL active_drag;
+
+    if (!hwnd || !rects) return FALSE;
+    style = get_window_long( hwnd, GWL_STYLE );
+    if (!(style & WS_POPUP)) return FALSE;
+    if (style & (WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) return FALSE;
+
+    width = rects->window.right - rects->window.left;
+    height = rects->window.bottom - rects->window.top;
+    if (width <= 0 || height <= 0) return FALSE;
+
+    /* Once a drag is active on this hwnd, keep matching at any size. The old
+     * 1200 cap made us drop park — custom stroke froze and Qt's noodle appeared. */
+    active_drag = cavalry_noodle.have_anchor && cavalry_noodle.hwnd == hwnd;
+    if (!active_drag && (width > 1600 || height > 1600)) return FALSE;
+
+    name.Buffer = buf;
+    name.MaximumLength = sizeof(buf);
+    name.Length = 0;
+    len = NtUserGetClassName( hwnd, FALSE, &name );
+    if (len < 16) return FALSE;
+    if (memcmp( buf, qt_iconW, 16 * sizeof(WCHAR) )) return FALSE;
+    return TRUE;
+}
+
+/* Copy 32bpp pixels including alpha. GDI BitBlt/StretchBlt/AlphaBlend cannot be
+ * trusted here: BI_BITFIELDS sources (Qt) lose or reject alpha. */
+static BOOL copy_layered_window_bits( HDC hdc_src, const RECT *src_rect,
+                                      struct window_surface *surface, const RECT *dst_rect )
+{
+    BITMAPOBJ *src_bmp, *dst_bmp;
+    HBITMAP src_handle;
+    dib_info src_dib, dst_dib;
+    INT width, height, y, sx, sy, dx, dy;
+    UINT32 sample = 0, opaque = 0, total = 0;
+    BOOL ret = FALSE;
+
+    width = dst_rect->right - dst_rect->left;
+    height = dst_rect->bottom - dst_rect->top;
+    if (width <= 0 || height <= 0) return FALSE;
+
+    src_handle = NtGdiGetDCObject( hdc_src, NTGDI_OBJ_SURF );
+    if (!src_handle) return FALSE;
+
+    if (!(src_bmp = GDI_GetObjPtr( src_handle, NTGDI_OBJ_BITMAP ))) return FALSE;
+    if (!init_dib_info_from_bitmapobj( &src_dib, src_bmp ))
+    {
+        GDI_ReleaseObj( src_handle );
+        return FALSE;
+    }
+
+    if (!(dst_bmp = GDI_GetObjPtr( surface->color_bitmap, NTGDI_OBJ_BITMAP )))
+    {
+        GDI_ReleaseObj( src_handle );
+        return FALSE;
+    }
+    if (!init_dib_info_from_bitmapobj( &dst_dib, dst_bmp ))
+    {
+        GDI_ReleaseObj( surface->color_bitmap );
+        GDI_ReleaseObj( src_handle );
+        return FALSE;
+    }
+
+    if (src_dib.bit_count == 32 && dst_dib.bit_count == 32 && src_dib.bits.ptr && dst_dib.bits.ptr)
+    {
+        sx = src_rect->left + src_dib.rect.left;
+        sy = src_rect->top + src_dib.rect.top;
+        dx = dst_rect->left + dst_dib.rect.left;
+        dy = dst_rect->top + dst_dib.rect.top;
+        if (sx >= src_dib.rect.left && sy >= src_dib.rect.top &&
+            dx >= dst_dib.rect.left && dy >= dst_dib.rect.top &&
+            sx + width <= src_dib.rect.right && sy + height <= src_dib.rect.bottom &&
+            dx + width <= dst_dib.rect.right && dy + height <= dst_dib.rect.bottom)
+        {
+            for (y = 0; y < height; y++)
+            {
+                UINT32 *s = (UINT32 *)((BYTE *)src_dib.bits.ptr + (sy + y) * src_dib.stride) + sx;
+                UINT32 *d = (UINT32 *)((BYTE *)dst_dib.bits.ptr + (dy + y) * dst_dib.stride) + dx;
+                INT x;
+
+                memcpy( d, s, width * sizeof(UINT32) );
+                /* Opaque pure-black often means a failed Qt tip glyph under XWayland;
+                 * treat as fully transparent so it neither paints nor steals hits. */
+                for (x = 0; x < width; x++)
+                {
+                    if (cavalry_invisible_noodle()) d[x] = 0;
+                    else if ((d[x] & 0x00ffffff) == 0) d[x] = 0;
+                    if (d[x] & 0xff000000) opaque++;
+                }
+                if (!y) sample = d[0];
+            }
+            total = (UINT32)width * (UINT32)height;
+            TRACE( "layered copy %dx%d src=%s dst=%s sample=%08x opaque=%u/%u%s\n",
+                   width, height, wine_dbgstr_rect( src_rect ), wine_dbgstr_rect( dst_rect ),
+                   sample, opaque, total, cavalry_invisible_noodle() ? " invisible_noodle" : "" );
+            ret = TRUE;
+        }
+    }
+
+    if (!ret)
+        WARN( "layered copy failed src_bpp=%d dst_bpp=%d src=%s dst=%s\n",
+              src_dib.bit_count, dst_dib.bit_count,
+              wine_dbgstr_rect( src_rect ), wine_dbgstr_rect( dst_rect ) );
+
+    GDI_ReleaseObj( surface->color_bitmap );
+    GDI_ReleaseObj( src_handle );
+    return ret;
+}
